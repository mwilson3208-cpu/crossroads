# Crossroads Leadership Academy form handler settings.
# On Netlify: Site configuration > Environment variables. Locally: copy this file to .env.
# Never commit a real .env file. It is listed in .gitignore.

# Where submissions go. One of: webhook, mailchimp, email, log
#   webhook   = GoHighLevel inbound webhook (or Zapier, Make, any URL that accepts JSON)
#   mailchimp = Mailchimp audience, tagged by form type
#   email     = an email to NOTIFY_EMAIL for every submission
#   log       = print to the function log only (local testing; never use in production)
FORM_DESTINATION=webhook

# --- webhook ---
# GoHighLevel: Automation > Workflows > Trigger "Inbound Webhook" > copy the URL.
GHL_WEBHOOK_URL=

# --- mailchimp ---
# API key from Mailchimp: Profile > Extras > API keys. It ends in a data center, like -us21.
MAILCHIMP_API_KEY=
# Audience ID from Mailchimp: Audience > Settings > Audience name and defaults.
MAILCHIMP_LIST_ID=

# --- email ---
# Who receives submissions. Separate several addresses with commas.
# Also used in mailchimp mode for student applications (they have no email address) and as a staff alert.
NOTIFY_EMAIL=
# Email is sent through Resend (resend.com, free tier is enough). Verify your domain there first.
RESEND_API_KEY=
# The sender, on the domain you verified in Resend.
EMAIL_FROM="Crossroads Website <forms@crossroadsleadershipacademy.org>"

# --- optional ---
# Public site address, used for the Sponsor Packet link. Netlify sets URL automatically, so this is only
# needed on Vercel or when testing locally.
SITE_URL=https://crossroadsleadershipacademy.org
# Override the Sponsor Packet link (for example, a Google Drive or Canva PDF link).
SPONSOR_PACKET_URL=
